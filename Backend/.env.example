# ---- Payment provider: PayPal Sandbox (live endpoints are never used) ----
PAYMENT_PROVIDER=paypal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
# Webhook ID shown in the PayPal developer dashboard after registering PAYPAL_WEBHOOK_URL
PAYPAL_WEBHOOK_ID=
PAYPAL_WEBHOOK_URL=https://YOUR_PUBLIC_HTTPS_URL/api/webhooks/paypal
# Where PayPal returns the sandbox buyer after approval
FRONTEND_URL=http://localhost:3000
ENABLE_PAYPAL_NEGATIVE_TESTING=false

# ---- Infrastructure ----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/payflow
REDIS_URL=redis://localhost:6380/0

# ---- AI (optional: without a key the deterministic investigator is used) ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Pipeline ----
PIPELINE_MODE=auto
PIPELINE_STEP_DELAY_SECONDS=0.8

# ---- Demo failure injection (affects PayFlow's own merchant/ledger systems only) ----
ENABLE_FAILURE_INJECTION=true
WEBHOOK_DELAY_SECONDS=20
WEBHOOK_GRACE_SECONDS=30
RECONCILIATION_DELAY_SECONDS=8

# ---- Policy ----
REFUND_AUTO_APPROVE_LIMIT_USD=25
MIN_AUTOMATION_CONFIDENCE=0.75

# ---- Automation controls ----
AUTOMATION_RATE_LIMIT=20
AUTOMATION_WINDOW_MINUTES=10

# ---- Operator alerts (all optional; unconfigured channels are skipped) ----
# WhatsApp via Meta Cloud API (developers.facebook.com -> your app -> WhatsApp -> API Setup).
# Add the admin number as a recipient there, then send any message to the business number
# from that phone so free-form alerts are delivered (24h window; template ping otherwise).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
ALERT_WHATSAPP_TO=
# Telegram bot (create with @BotFather, get chat id from getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Push to any phone: install the free ntfy app and subscribe to this topic
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
SLACK_WEBHOOK_URL=
ALERT_WEBHOOK_URL=
ALERT_ESCALATION_MINUTES=5
BACKGROUND_PUMP_ENABLED=true

# ---- Hosting (auto-detected; only needed to override) ----
# PUBLIC_API_URL=https://payflowai.onrender.com
# CORS_ORIGIN_REGEX=https://[a-z0-9-]+\.vercel\.app
